# Example environment for running the seula CLI locally. Copy to `.env` (gitignored) in the
# folder you run seula from: this repo for its own specs, or an adopting repo's root.
# seula reads `.env` from the current folder; variables already set in the environment win.
# Every variable is optional: leave out what you don't use.
# Never commit real values, and never paste them into a chat, a ticket or a pull request.

# --- Jev (G0 and G1 judgement checks, calibrate) ---------------------------------------------
# Your TypeSafe key. Without it, the Jev checks are recorded as skipped and only the scripted
# checks run. In CI the same key is the secret SEULA_TYPESAFE_API_KEY (see the CI reference).
TYPESAFE_API_KEY=

# --- Jira tracker (seula tracker … --tracker jira) ------------------------------------------
JIRA_BASE_URL=        # https://<your-site>.atlassian.net, no trailing slash
JIRA_EMAIL=           # the email of the Atlassian account that owns the API token
JIRA_API_TOKEN=       # id.atlassian.com → Security → API tokens → "Create API token" (not "with scopes")

# --- GitHub Issues tracker (seula tracker … --tracker github) -------------------------------
GITHUB_TOKEN=         # fine-grained, only the repo: Issues read/write
GITHUB_REPOSITORY=    # owner/repo
# GITHUB_API_URL=     # only for GitHub Enterprise; leave commented out (an empty value breaks the default)

# --- CI reference: NOT read from this file ---------------------------------------------------
# In an adopting repo, seula's workflows get their values from GitHub: repo → Settings →
# Secrets and variables → Actions (or `gh secret set <NAME> --repo <owner>/<repo>`).
# The caller workflow that `seula init` writes passes each one by name, never `secrets: inherit`.
# Full steps: docs/setup-jira.md or docs/setup-github-issues.md.
#
# SEULA_ANTHROPIC_API_KEY  An Anthropic key for seula only (platform.claude.com; best in its own
#                          workspace with a spend limit), not an ANTHROPIC_API_KEY the app uses.
# SEULA_GH_TOKEN           Fine-grained token, only the adopting repo: Contents + Pull requests
#                          read/write (+ Issues read/write for the GitHub Issues tracker).
#                          Pushes made with it start the repo's CI; GITHUB_TOKEN pushes don't.
# SEULA_TYPESAFE_API_KEY   The TypeSafe key (optional).
# JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN   Jira only; the same values as above.
#
# Jira only, and not a GitHub secret: the automation rule's dispatch token (fine-grained, only
# the adopting repo, Contents read/write) lives only in the rule's Authorization header,
# marked hidden.
