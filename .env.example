# Example environment for running the seula CLI locally. Copy to `.env` (gitignored) in the
# folder you run seula from: this repo for its own specs, or an adopting repo's root.
# seula reads `.env` from the current folder; variables already set in the environment win.
# Every variable is optional: leave out what you don't use. Never commit real values.
# In CI the workflows get these from repository secrets instead (docs/setup-jira.md,
# docs/setup-github-issues.md).

# --- Jev (G0 and G1 judgement checks, calibrate) ---------------------------------------------
# Without it, the Jev checks are recorded as skipped and only the scripted checks run.
TYPESAFE_API_KEY=

# --- Jira tracker (seula tracker … --tracker jira) ------------------------------------------
JIRA_BASE_URL=        # https://<your-site>.atlassian.net
JIRA_EMAIL=           # the Atlassian account that owns the API token
JIRA_API_TOKEN=       # a classic (unscoped) API token from id.atlassian.com

# --- GitHub Issues tracker (seula tracker … --tracker github) -------------------------------
GITHUB_TOKEN=         # issues read/write on the repo
GITHUB_REPOSITORY=    # owner/repo
# GITHUB_API_URL=     # only for GitHub Enterprise; leave commented out (an empty value breaks the default)
